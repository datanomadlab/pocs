# Lo que el lector puede cambiar, con un comentario por variable. Copia este archivo a .env.
# Nunca credenciales: la base Postgres es un contenedor local que se borra con make destroy.

# Hasta qué día llega la historia que se carga antes de simular (el dataset va de 2009-12-01 a 2011-12-09).
HISTORIA_HASTA=2010-11-30

# Cuántos días con ventas se simulan, con una corrida diaria por camino.
DIAS=30

# El límite de cada corrida. 1 vCPU y 512 MB es lo mínimo que acepta un job de Cloud Run.
CPUS=1
MEMORIA_MB=512

# El Postgres de origen y el puerto local donde escucha.
IMAGEN_POSTGRES=postgres:18.7
PUERTO_POSTGRES=54303
