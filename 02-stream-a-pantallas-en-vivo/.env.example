# Lo que el lector puede cambiar, con un comentario por variable. Copia este archivo a .env.
# Nunca credenciales: nada de este experimento necesita una cuenta en la nube.

# Eventos por segundo de la carga nominal.
TASA=10000
# Tasa de las rutas simuladas (emuladores de Kinesis y SQS): solo comprueban que funcionan.
TASA_SIMULADA=1000
# Emisores distintos y cuentas entre las que se reparten. Cada pantalla mira varias cuentas.
EMISORES=100000
CUENTAS=1000
# Conexiones WebSocket abiertas por la sonda.
PANTALLAS=100
# Pantallas que miran cada cuenta. Con más de 1, un evento se entrega a varias pantallas y hace
# falta CUENTAS x ESPECTADORES >= PANTALLAS. La matriz de `make concurrencia` fija su propio valor.
ESPECTADORES=1
# Tamaño de cada evento, en bytes.
BYTES=300
# Una ruta "aguanta" una tasa si el 99 % de los eventos llega a la pantalla en menos de esto.
P99_MAX_MS=1000
# Veces que se repite la prueba de corte en cada ruta. Lo que pasa al matar un consumidor depende de
# en qué estaba en ese instante, así que con un solo corte el resultado es cuestión de suerte.
CORTES=2
# Cuánto tarda el broker de Kafka en dar por muerto a un consumidor, en ms. Vacío = el valor de
# fábrica de cada cliente (45 s en Go, 30 s en Node). Solo aplica a los consumidores escritos a mano sobre Redpanda.
SESION_MS=
# Rutas a correr, separadas por coma. Vacío = todas las de rutas.toml.
RUTAS=
# 1 = fases más cortas, para probar que todo levanta. Los números de una corrida rápida no se publican.
RAPIDO=
